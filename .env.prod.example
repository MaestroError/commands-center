# CommandsCenter production runtime configuration.
# Generated production env files are based on this template. Existing shell environment variables always win over values in the env file.

# Runtime and server
# Controls the CommandsCenter process mode, HTTP bind address, logging, portable state location, and credential encryption key.
NODE_ENV=production
CC_HOST=0.0.0.0
CC_PORT=3000
CC_WORKSPACE_DIR=.cc/workspace
CC_DATA_DIR=.cc/data
# Pino log level: fatal, error, warn, info, debug, trace, or silent.
CC_LOG_LEVEL=info
# Generated automatically on first start. Keep this value private and backed up.
CC_SECRET_KEY=


# Public origin and reverse proxy
# Set CC_PUBLIC_ORIGIN to the exact HTTPS origin operators open in the browser when CommandsCenter is exposed through a domain or reverse proxy.
# Example: CC_PUBLIC_ORIGIN=https://commands.example.com
CC_PUBLIC_ORIGIN=
# Optional comma-separated additional trusted origins for proxy aliases. Leave empty unless you intentionally serve the same instance from multiple origins.
CC_ALLOWED_ORIGINS=


# OpenCode engine
# Settings for the managed opencode serve process started and monitored by CommandsCenter.
CC_OPENCODE_HOST=127.0.0.1
CC_OPENCODE_PORT=4100
CC_OPENCODE_TIMEOUT_MS=30000
CC_OPENCODE_STARTUP_TIMEOUT_MS=30000
CC_OPENCODE_SHUTDOWN_TIMEOUT_MS=15000
CC_OPENCODE_HEALTH_POLL_MS=2000
CC_OPENCODE_MAX_RESTARTS=3
CC_OPENCODE_RESTART_WINDOW_MS=60000
# Optional path to a custom OpenCode binary. Leave empty to use the bundled dependency.
CC_OPENCODE_PATH=


# Runtime limits and shutdown
# Timeouts and optional task limits used by API, MCP auth, and graceful shutdown flows.
CC_MCP_AUTH_TIMEOUT_MS=90000
CC_DRAIN_TIMEOUT_MS=15000
# Empty or 0 means unlimited.
CC_MAX_TASKS=


# Updates and install mode
# Controls update checks, optional auto-update behavior, and install-mode detection.
CC_UPDATE_CHECK=true
CC_UPDATE_INTERVAL_MS=21600000
# Docker installs never auto-update from inside the container.
CC_AUTO_UPDATE=false
CC_UPDATE_REGISTRY_URL=https://registry.npmjs.org/commandscenter/latest
CC_DOCKER=false
# Optional override for update install-mode detection.
CC_NPM_GLOBAL_ROOT=
# Optional Docker marker path override for tests and unusual container environments.
CC_DOCKER_ENV_PATH=


# Development and diagnostics
# Optional paths used for local package diagnostics. Most production installs should leave these empty.
CC_BUILTIN_SKILLS_DIR=


# Service installer
# Variables consumed by scripts/install-ccenter-service.sh, not by the running app unless the installer writes them into the generated env file.
CCENTER_PACKAGE_SPEC=
CCENTER_INSTALL_DIR=
CCENTER_WORKSPACE_DIR=
CCENTER_ENV_FILE=
CCENTER_HOST=
CCENTER_PORT=
CCENTER_PUBLIC_HOST=
CCENTER_NODE_MAJOR=22


# Ambient shell and CI
# Variables read from the surrounding process by tools. Do not set these in normal app configuration.
# INIT_CWD=
# HOME=
# CI=
