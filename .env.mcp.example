# MCP Server API Keys
#
# Copy this file to .env.mcp and fill in your keys.
# Then copy the values into .mcp.json (Claude Code reads .mcp.json directly).
#
# After updating .mcp.json locally, prevent git from tracking your changes:
#   git update-index --skip-worktree .mcp.json
#
# To undo (if you need to commit structural changes to .mcp.json):
#   git update-index --no-skip-worktree .mcp.json

# Context7 — library documentation for AI coding
# Get your key at https://context7.com
CONTEXT7_API_KEY=
