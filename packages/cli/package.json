{
  "name": "commandscenter",
  "version": "0.1.0",
  "type": "module",
  "description": "Single-user AI agent management — install, run, done.",
  "bin": {
    "ccenter": "./dist/bin.mjs"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node --import tsx/esm build.ts",
    "start": "node dist/bin.mjs start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fastify/static": "^8.1.0",
    "better-sqlite3": "^12.0.0",
    "fastify": "^5.3.3",
    "opencode-ai": "^1.14.22"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "catalog:",
    "tsx": "^4.19.0"
  }
}
