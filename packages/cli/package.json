{
  "name": "commandscenter",
  "version": "1.0.0",
  "type": "module",
  "description": "Single-user AI specialist management — install, run, done.",
  "license": "Apache-2.0",
  "author": "maestroerror",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaestroError/commands-center.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/MaestroError/commands-center",
  "bugs": {
    "url": "https://github.com/MaestroError/commands-center/issues"
  },
  "bin": {
    "ccenter": "./dist/bin.mjs"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node --import tsx/esm build.ts",
    "start": "node dist/bin.mjs start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fastify/static": "^10.1.1",
    "@opencode/sdk": "2.1.4",
    "@vscode/ripgrep": "1.18.0",
    "better-sqlite3": "^12.0.0",
    "fastify": "^5.12.2",
    "node-pty": "1.2.0-beta.14",
    "pino-pretty": "^13.0.0",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@cc/backend": "workspace:*",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "catalog:"
  }
}
