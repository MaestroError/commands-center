{
  "name": "@cc/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cc/shared": "workspace:*",
    "fastify": "^5.3.3",
    "fastify-type-provider-zod": "^6.0.0",
    "zod": "^4.3.6",
    "drizzle-orm": "^0.44.0",
    "better-sqlite3": "^12.0.0",
    "ws": "^8.18.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/ws": "^8.18.0",
    "@types/node": "^22.0.0",
    "typescript": "catalog:",
    "tsx": "^4.19.0",
    "drizzle-kit": "^0.31.0"
  }
}
