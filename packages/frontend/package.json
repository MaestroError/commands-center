{
  "name": "@cc/frontend",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "NODE_OPTIONS='--max-old-space-size=8192' vitest run --maxWorkers=1",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=8192' vitest run --coverage --maxWorkers=1",
    "test:e2e": "playwright test",
    "test:e2e:tasks": "playwright test --grep @tasks --project=chromium",
    "test:e2e:other": "playwright test --grep-invert @tasks",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cc/shared": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@milkdown/crepe": "^7.21.2",
    "@milkdown/kit": "^7.21.2",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.90.5",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.542.0",
    "radix-ui": "^1.6.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^14.3.8",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "rehype-sanitize": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "catalog:",
    "vite": "^7.3.6"
  }
}
