# Runtime
NODE_ENV=development
CC_PORT=3000
CC_HOST=0.0.0.0
CC_LOG_LEVEL=debug

# Portable workspace paths
CC_DATA_DIR=.cc
# CC_WORKSPACE_DIR=.cc/workspace

# OpenCode engine
CC_ENGINE_HOST=127.0.0.1
CC_ENGINE_PORT=4096
CC_ENGINE_TIMEOUT_MS=30000
CC_ENGINE_STARTUP_TIMEOUT_MS=30000
CC_ENGINE_SHUTDOWN_TIMEOUT_MS=15000
CC_ENGINE_HEALTH_POLL_MS=2000
CC_ENGINE_MAX_RESTARTS=3
CC_ENGINE_RESTART_WINDOW_MS=60000

# Optional power-user override for a custom OpenCode binary
# CC_OPENCODE_PATH=

# Auth and shutdown timeouts
CC_PROVIDER_AUTH_TIMEOUT_MS=300000
CC_MCP_AUTH_TIMEOUT_MS=90000
CC_DRAIN_TIMEOUT_MS=15000
