# Database
# For local development (SQLite), leave this unset or set to a file path
# For PostgreSQL, use: postgres://user:password@host:5432/dbname
# DATABASE_URL=

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Logging
LOG_LEVEL=debug

# OpenCode AI Engine
# Path to opencode binary (optional, defaults to node_modules/.bin/opencode)
# OPENCODE_BINARY_PATH=

# Workspace
# The directory used as the workspace root
WORKSPACE_DIR=.cc

# Automation limits
MAX_AUTOMATION_RUNS_PER_HOUR=10

# Provider API Keys (add as needed)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Composio (optional)
# COMPOSIO_API_KEY=
