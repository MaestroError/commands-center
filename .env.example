# Runtime
NODE_ENV=development
CC_PORT=3000
CC_HOST=0.0.0.0
CC_LOG_LEVEL=debug

# Portable workspace paths
# CC_WORKSPACE_DIR=.cc/workspace
# In production the workspace lives under the user's home (e.g. /Users/<you>/.cc/workspace).
# When developing inside this repo, the default ".cc/workspace" sits inside the
# project's git worktree, which causes opencode to merge the repo's own
# opencode.jsonc on top of the managed workspace config. To match production
# behaviour locally, point the workspace at an absolute path outside the repo, e.g.:
#   CC_WORKSPACE_DIR=/Users/<you>/cc-dev/.cc/workspace
# (The loader does not expand "~"; use a fully-qualified absolute path.)

# OpenCode
CC_OPENCODE_HOST=127.0.0.1
CC_OPENCODE_PORT=4100
CC_OPENCODE_TIMEOUT_MS=30000
CC_OPENCODE_STARTUP_TIMEOUT_MS=30000
CC_OPENCODE_SHUTDOWN_TIMEOUT_MS=15000
CC_OPENCODE_HEALTH_POLL_MS=2000
CC_OPENCODE_MAX_RESTARTS=3
CC_OPENCODE_RESTART_WINDOW_MS=60000

# Optional power-user override for a custom OpenCode binary
# CC_OPENCODE_PATH=

# Secrets encryption key
# Change this before using shared or production workspaces.
CC_SECRET_KEY=development-secret-key-change-me

# Auth and shutdown timeouts
CC_MCP_AUTH_TIMEOUT_MS=90000
CC_DRAIN_TIMEOUT_MS=15000
