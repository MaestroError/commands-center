# Runtime
NODE_ENV=development
CC_PORT=3000
CC_HOST=0.0.0.0
CC_LOG_LEVEL=debug

# Exact browser and OAuth origin. External origins must use HTTPS and must not
# include a path or trailing slash. Changing it invalidates existing OAuth
# client registrations and tokens, so MCP clients must reconnect.
# CC_PUBLIC_ORIGIN=https://commands.example.com

# Optional comma-separated browser-origin aliases for the same instance.
# CC_ALLOWED_ORIGINS=https://commands-alt.example.com

# Safe default: false. Keep it false when opening CC directly at its host/port.
# Set true for the usual public/company-domain setup:
#   browser -> https://cc.company.com -> Caddy/nginx/tunnel/load balancer -> CC
# In that setup, the proxy must be the only way to reach CC and must overwrite
# X-Forwarded-For, X-Forwarded-Proto, and X-Forwarded-Host. True lets CC see the
# user's IP and the original HTTPS domain instead of the proxy's IP and its
# private HTTP connection. False is the default because clients can fake these
# headers when no trusted proxy is in front of CC.
# CC_PUBLIC_ORIGIN still defines the public URL. Restart CC after changing this.
CC_TRUST_PROXY=false

# Portable workspace paths
# CC_WORKSPACE_DIR=.cc/workspace
# CC_DATA_DIR=.cc/data
# In production the workspace and data dirs live under the user's home:
#   ~/.cc/workspace  (portable config and assets — the source of truth)
#   ~/.cc/data       (disposable DB — cc.db lives here)
# When developing inside this repo, the defaults resolve relative to INIT_CWD
# (the repo root), which causes opencode to merge the repo's own opencode.jsonc
# on top of the managed workspace config. To match production behaviour locally,
# point both paths at an absolute path outside the repo, e.g.:
#   CC_WORKSPACE_DIR=/Users/<you>/cc-dev/.cc/workspace
#   CC_DATA_DIR=/Users/<you>/cc-dev/.cc/data
# (The loader does not expand "~"; use fully-qualified absolute paths.)

# Embedded OpenCode v2 (no daemon binary, host or port).
# Engine state and npm cache live under <workspace>/.cc/opencode-v2/.
CC_OPENCODE_TIMEOUT_MS=30000
# Timeout for local/stdio MCP initialization, discovery, and requests.
CC_MCP_STDIO_TIMEOUT_MS=120000

# Secrets encryption key
# Change this before using shared or production workspaces.
CC_SECRET_KEY=development-secret-key-change-me

# Auth and shutdown timeouts
CC_MCP_AUTH_TIMEOUT_MS=90000
CC_DRAIN_TIMEOUT_MS=15000
